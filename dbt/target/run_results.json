{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.0", "generated_at": "2026-08-02T19:43:16.041040Z", "invocation_id": "0866fda3-ad93-4279-91a6-22a3720ca702", "invocation_started_at": "2026-08-02T19:43:12.520086Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-02T19:43:15.946004Z", "completed_at": "2026-08-02T19:43:15.951108Z"}, {"name": "execute", "started_at": "2026-08-02T19:43:15.951414Z", "completed_at": "2026-08-02T19:43:15.951427Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.006169557571411133, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.anp_fuel.stg_precos", "compiled": true, "compiled_code": "-- Staging: ponte padronizada entre a fonte e os modelos anal\u00edticos.\n-- Regra: s\u00f3 renomes leves, casts e deriva\u00e7\u00f5es simples. Nada de agrega\u00e7\u00e3o.\n\nSELECT\n    id,\n    revenda,\n    cnpj,\n    regiao,\n    uf,\n    cidade,\n    bairro,\n    produto,\n    data_coleta,\n    valor_venda,\n    bandeira,\n    DATE_TRUNC('month', data_coleta)::date AS mes_coleta\nFROM \"anp_fuel\".\"public\".\"precos_combustiveis\"", "relation_name": "\"anp_fuel\".\"public\".\"stg_precos\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-02T19:43:15.954845Z", "completed_at": "2026-08-02T19:43:15.958584Z"}, {"name": "execute", "started_at": "2026-08-02T19:43:15.960552Z", "completed_at": "2026-08-02T19:43:15.960562Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0069353580474853516, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.anp_fuel.gold_ranking_bandeiras", "compiled": true, "compiled_code": "-- Participa\u00e7\u00e3o de cada bandeira no total de coletas, por UF.\n-- Exercita: window functions (participa\u00e7\u00e3o percentual e ranking).\n\nSELECT\n    uf,\n    bandeira,\n    COUNT(*)                                          AS qtd_coletas,\n    COUNT(DISTINCT cnpj)                              AS qtd_postos,\n    ROUND(\n        100.0 * COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY uf),\n        2\n    )                                                 AS participacao_pct,\n    RANK() OVER (PARTITION BY uf ORDER BY COUNT(*) DESC) AS posicao\nFROM \"anp_fuel\".\"public\".\"stg_precos\"\nGROUP BY uf, bandeira", "relation_name": "\"anp_fuel\".\"public\".\"gold_ranking_bandeiras\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-02T19:43:15.958884Z", "completed_at": "2026-08-02T19:43:15.983888Z"}, {"name": "execute", "started_at": "2026-08-02T19:43:15.984332Z", "completed_at": "2026-08-02T19:43:15.984343Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.026982784271240234, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.anp_fuel.gold_variacao_mensal", "compiled": true, "compiled_code": "-- Varia\u00e7\u00e3o percentual do pre\u00e7o m\u00e9dio m\u00eas a m\u00eas, por UF e produto.\n-- Exercita: LAG (compara\u00e7\u00e3o com o per\u00edodo anterior).\n\nWITH mensal AS (\n    SELECT\n        uf,\n        produto,\n        mes_coleta,\n        AVG(valor_venda) AS preco_medio\n    FROM \"anp_fuel\".\"public\".\"stg_precos\"\n    GROUP BY uf, produto, mes_coleta\n)\n\nSELECT\n    uf,\n    produto,\n    mes_coleta,\n    ROUND(preco_medio, 3) AS preco_medio,\n    ROUND(\n        100.0 * (preco_medio - LAG(preco_medio) OVER w) / LAG(preco_medio) OVER w,\n        2\n    ) AS variacao_pct\nFROM mensal\nWINDOW w AS (PARTITION BY uf, produto ORDER BY mes_coleta)", "relation_name": "\"anp_fuel\".\"public\".\"gold_variacao_mensal\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-02T19:43:15.963320Z", "completed_at": "2026-08-02T19:43:15.992144Z"}, {"name": "execute", "started_at": "2026-08-02T19:43:15.993058Z", "completed_at": "2026-08-02T19:43:15.993063Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.036473751068115234, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.anp_fuel.gold_preco_mensal_uf", "compiled": true, "compiled_code": "-- Pre\u00e7o m\u00e9dio mensal por UF e produto \u2014 tabela pronta para an\u00e1lise/dashboard.\n\nSELECT\n    uf,\n    produto,\n    mes_coleta,\n    ROUND(AVG(valor_venda), 3) AS preco_medio,\n    MIN(valor_venda)           AS preco_min,\n    MAX(valor_venda)           AS preco_max,\n    COUNT(*)                   AS qtd_coletas\nFROM \"anp_fuel\".\"public\".\"stg_precos\"\nGROUP BY uf, produto, mes_coleta", "relation_name": "\"anp_fuel\".\"public\".\"gold_preco_mensal_uf\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-02T19:43:15.961331Z", "completed_at": "2026-08-02T19:43:15.964728Z"}, {"name": "execute", "started_at": "2026-08-02T19:43:15.991181Z", "completed_at": "2026-08-02T19:43:15.991188Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.034194231033325195, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.anp_fuel.gold_etanol_vs_gasolina", "compiled": true, "compiled_code": "-- Compara pre\u00e7o m\u00e9dio mensal de etanol e gasolina por UF e aplica a\n-- regra dos 70%: etanol compensa se custar at\u00e9 70% da gasolina\n-- (por render ~30% menos por litro).\n\nWITH precos_mensais AS (\n    SELECT\n        uf,\n        mes_coleta,\n        produto,\n        AVG(valor_venda) AS preco_medio\n    FROM \"anp_fuel\".\"public\".\"stg_precos\"\n    WHERE produto IN ('ETANOL', 'GASOLINA')\n    GROUP BY uf, mes_coleta, produto\n),\n\npivotado AS (\n    SELECT\n        uf,\n        mes_coleta,\n        MAX(CASE WHEN produto = 'ETANOL'   THEN preco_medio END) AS preco_etanol,\n        MAX(CASE WHEN produto = 'GASOLINA' THEN preco_medio END) AS preco_gasolina\n    FROM precos_mensais\n    GROUP BY uf, mes_coleta\n)\n\nSELECT\n    uf,\n    mes_coleta,\n    ROUND(preco_etanol, 3)                       AS preco_etanol,\n    ROUND(preco_gasolina, 3)                     AS preco_gasolina,\n    ROUND(preco_etanol / preco_gasolina, 4)      AS razao_etanol_gasolina,\n    CASE\n        WHEN preco_etanol / preco_gasolina <= 0.70 THEN 'ETANOL'\n        ELSE 'GASOLINA'\n    END                                          AS combustivel_vantajoso\nFROM pivotado\nWHERE preco_etanol IS NOT NULL\n  AND preco_gasolina IS NOT NULL", "relation_name": "\"anp_fuel\".\"public\".\"gold_etanol_vs_gasolina\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-02T19:43:15.965732Z", "completed_at": "2026-08-02T19:43:15.993930Z"}, {"name": "execute", "started_at": "2026-08-02T19:43:16.002356Z", "completed_at": "2026-08-02T19:43:16.002360Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0373842716217041, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.anp_fuel.accepted_values_stg_precos_produto__GASOLINA__GASOLINA_ADITIVADA__ETANOL__DIESEL__DIESEL_S10__GNV.2f04d79999", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        produto as value_field,\n        count(*) as n_records\n\n    from \"anp_fuel\".\"public\".\"stg_precos\"\n    group by produto\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'GASOLINA','GASOLINA ADITIVADA','ETANOL','DIESEL','DIESEL S10','GNV'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-02T19:43:16.003563Z", "completed_at": "2026-08-02T19:43:16.008448Z"}, {"name": "execute", "started_at": "2026-08-02T19:43:16.013516Z", "completed_at": "2026-08-02T19:43:16.013521Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0